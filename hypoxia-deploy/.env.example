# Copy this file to .env and fill in your values

# HuggingFace Space URL (after deployment)
HF_API_URL=https://YOUR-USERNAME-hypoxia-prediction-api.hf.space/predict

# HiveMQ Cloud credentials (from hivemq.com/mqtt-cloud-broker)
MQTT_BROKER=your-cluster.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your-hivemq-username
MQTT_PASS=your-hivemq-password
